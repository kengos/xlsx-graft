.DS_Store

# Rust build output
/engine/target/

# Coverage report written by `make engine:coverage`
/engine/lcov.info

# Full gate logs written by `make quiet T=<target>`
/.make-logs/

# The C ABI library `make engine:capi-lib` builds for the SDKs
/dist/

# Coverage report written by `make sdk:ruby:test` / `sdk:ruby:verify`
/sdk/ruby/coverage/
