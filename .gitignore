.DS_Store

# Rust build output
/engine/target/

# Coverage report written by `make engine:coverage`
/engine/lcov.info

# Full gate logs written by `make quiet T=<target>`
/.make-logs/

# The C ABI library `make engine:capi-lib`, the Node.js addon
# `make engine:napi` and the CLI `make engine:cli-bin` build for the SDKs
/dist/

# Coverage report written by `make sdk:test:ruby` / `sdk:verify:ruby`
/sdk/ruby/coverage/
