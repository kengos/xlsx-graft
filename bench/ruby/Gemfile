gem "roo"
gem "rubyXL"
gem "simple_xlsx_reader"
gem "xsv"

# The Ruby SDK (sdk/ruby, loaded from the checkout) needs it, with the same
# range as its gemspec.
gem "fiddle", "~> 1.1"
