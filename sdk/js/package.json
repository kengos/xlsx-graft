{
  "name": "xlsx-graft",
  "version": "0.0.0",
  "description": "Read, verify, create and edit xlsx workbooks",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "license": "MIT OR Apache-2.0 OR BSD-3-Clause",
  "author": "kengos",
  "homepage": "https://github.com/kengos/xlsx-graft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kengos/xlsx-graft.git",
    "directory": "sdk/js"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE-APACHE",
    "LICENSE-BSD",
    "LICENSE-MIT"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
