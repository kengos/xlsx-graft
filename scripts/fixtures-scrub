#!/usr/bin/env python3
"""Remove the names and local paths Excel saves in a workbook, in place.

    python3 -I scripts/fixtures-scrub BOOK...

Excel for Mac writes into every workbook it saves the account's name and
the folder it saved the workbook in. A workbook in fixtures/ is published,
so before it is added, this script rewrites each BOOK so that

  - docProps/core.xml has an empty dc:creator and cp:lastModifiedBy,
  - xl/workbook.xml has no x15ac:absPath (the folder the workbook was saved
    in), together with the mc:AlternateContent element that holds it,
  - each xl/externalLinks/externalLinkN.xml has no xxl21:alternateUrls (the
    absolute path of the linked workbook, beside the relative one Excel
    reads first), and its .rels file no relationship that only those
    alternate URLs named.

Every other entry is copied unchanged, in the same order and with the same
compression. The script then reads every entry of the rewritten BOOK and
exits 1, leaving that BOOK as it was, when one of them still holds the
home folder of the account that runs it (os.path.expanduser("~")).

scripts/check-fixtures.sh checks the same things of every workbook in
fixtures/ as part of `make engine:budget`. Run this script through
`make fixtures:scrub`, or directly for a path that contains a space.
"""

import os
import re
import sys
import tempfile
import zipfile

CORE = "docProps/core.xml"
WORKBOOK = "xl/workbook.xml"
EXTERNAL_LINK = re.compile(r"^xl/externalLinks/externalLink\d+\.xml$")

# A dc:creator or cp:lastModifiedBy element with any text.
NAME = re.compile(rb"<(dc:creator|cp:lastModifiedBy)>[^<]*</\1>")
# The mc:AlternateContent element Excel wraps x15ac:absPath in.
ABS_PATH = re.compile(
    rb"<mc:AlternateContent\b[^>]*>(?:(?!</mc:AlternateContent>).)*?"
    rb"<x15ac:absPath\b.*?</mc:AlternateContent>",
    re.S,
)
ALTERNATE_URLS = re.compile(rb"<xxl21:alternateUrls\b.*?</xxl21:alternateUrls>", re.S)
REL_ID = re.compile(rb'r:id="([^"]+)"')


def rels_name(name):
    """The name of the .rels entry of the part `name`."""
    folder, file = name.rsplit("/", 1)
    return f"{folder}/_rels/{file}.rels"


def drop_relationships(rels, ids):
    """`rels` without the Relationship elements whose Id is in `ids`."""
    for rel_id in ids:
        pattern = rb'<Relationship\b[^>]*\bId="' + re.escape(rel_id) + rb'"[^>]*/>'
        rels = re.sub(pattern, b"", rels)
    return rels


def scrub(entries):
    """`entries` ({name: bytes}) with the names and paths removed."""
    out = dict(entries)
    if CORE in out:
        out[CORE] = NAME.sub(rb"<\1></\1>", out[CORE])
    if WORKBOOK in out:
        out[WORKBOOK] = ABS_PATH.sub(b"", out[WORKBOOK])
    for name in entries:
        if not EXTERNAL_LINK.match(name):
            continue
        dropped = [m.group(0) for m in ALTERNATE_URLS.finditer(out[name])]
        out[name] = ALTERNATE_URLS.sub(b"", out[name])
        rels = rels_name(name)
        if dropped and rels in out:
            ids = {i for block in dropped for i in REL_ID.findall(block)}
            still = set(REL_ID.findall(out[name]))
            out[rels] = drop_relationships(out[rels], ids - still)
    return out


def rewrite(path):
    """Scrubs the workbook at `path`; returns an error message or None."""
    with zipfile.ZipFile(path) as zf:
        infos = zf.infolist()
        entries = {info.filename: zf.read(info) for info in infos}
    scrubbed = scrub(entries)
    home = os.path.expanduser("~").encode()
    left = [name for name, data in scrubbed.items() if home in data]
    if left:
        return f"{path}: still holds {home.decode()} in {', '.join(left)}"
    folder = os.path.dirname(os.path.abspath(path))
    fd, tmp = tempfile.mkstemp(dir=folder, suffix=".xlsx")
    os.close(fd)
    try:
        with zipfile.ZipFile(tmp, "w") as zf:
            for info in infos:
                zf.writestr(info, scrubbed[info.filename], compress_type=info.compress_type)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise
    return None


def main(argv):
    if not argv:
        print("usage: python3 -I scripts/fixtures-scrub BOOK...", file=sys.stderr)
        return 2
    status = 0
    for path in argv:
        error = rewrite(path)
        if error:
            print(f"fixtures-scrub: {error}", file=sys.stderr)
            status = 1
        else:
            print(f"fixtures-scrub: {path}")
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
